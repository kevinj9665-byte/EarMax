{
  "name": "earshot",
  "private": true,
  "version": "1.0.0-rc2",
  "type": "module",
  "scripts": {
    "dev": "node -e \"if(!require('fs').existsSync('node_modules/.bin/vite'))require('child_process').execSync('npm ci --no-audit --no-fund',{stdio:'inherit'})\" && vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
